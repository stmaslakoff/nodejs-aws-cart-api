# Node modules - not needed in container as we'll install fresh dependencies
node_modules/
# Explanation: Contains all npm dependencies, very large and should be installed fresh in container

# Build output directory
dist/
# Explanation: Contains compiled JavaScript, will be rebuilt in container

# Test files and coverage reports - not needed in production
test/
coverage/
*.spec.ts
# Explanation: Test files and coverage reports are not needed in production environment

# Git related files
.git/
.gitignore
# Explanation: Version control files not needed in container

# Development configuration files
.env*
*.log
npm-debug.log*
# Explanation: Environment and debug files should not be in container

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
# Explanation: IDE and editor specific files not needed in container

# Docker files themselves
Dockerfile
.dockerignore
# Explanation: Docker-related files not needed inside container

# TypeScript source maps
*.map
# Explanation: Source maps not needed in production

# npm logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Explanation: Debug and error logs not needed in container